#!/bin/sh
# .githooks/pre-push — M-007. Blocks a push that fails the check chain.
#
# Git feeds this hook `<local ref> <local sha> <remote ref> <remote sha>` on stdin. It is consumed
# here and PIPED TO THE SCOPE, because the scope must follow what is being PUSHED, not what happens
# to be checked out: `git push origin migration-branch` from a docs branch previously returned
# "quick" and skipped the DB tier on a diff full of migrations.
#
# The DB tier (test:db + security:db, ~8 of the ~10 minutes) runs only when the diff can affect it.
# CI's db-tests job runs it on every PR regardless, so it is moved off the local hot path, never
# skipped. Fails toward MORE checking: any error deciding runs the full chain.
set -e
REFS=$(cat)

# PLEKS_PREPUSH_CMD is a probe seam and requires PLEKS_HOOK_PROBE=1 alongside it. Without that
# second variable it is ignored — `PLEKS_PREPUSH_CMD=true git push` used to be a silent, complete
# bypass, functionally --no-verify, which CLAUDE.md forbids by name. Two variables is not security;
# it is the difference between a deliberate act and a convenient one.
if [ -n "$PLEKS_PREPUSH_CMD" ] && [ "$PLEKS_HOOK_PROBE" = "1" ]; then
  CMD="$PLEKS_PREPUSH_CMD"
else
  SCOPE=$(printf '%s\n' "$REFS" | node scripts/prepush-scope.mjs 2>/dev/null || echo full)
  if [ "$SCOPE" = "quick" ]; then
    CMD="npm run check"
    echo "pre-push → pushed refs touch no DB surface; running check (DB tier runs in CI on the PR)"
  else
    CMD="npm run check:full"
    echo "pre-push → pushed refs touch DB surface; running the full chain"
  fi
fi
echo "pre-push → $CMD"
$CMD

# ── Schema drift, on BOTH scopes (2026-08-22) ────────────────────────────────────────────────────
# `check:full` already chains this, so on the full scope the call below is a ~0.3s no-op that finds
# a fresh stamp. It is here for the QUICK scope, and that is the whole point: drift was previously
# reachable only when a push touched a DB surface, so a migration merged by someone else and never
# applied to prod was invisible to every ordinary push. `contact_change_requests` survived four days
# that way and was found by coincidence. See scripts/check-drift-if-sql-changed.mjs.
#
# Cheap enough to sit outside the scope gate: it self-throttles to once per STALE_DAYS per clone,
# and a machine holding no Supabase token reports "DUE AND NOT RUN" and exits 0 rather than blocking
# a docs push on a credential it was never expected to have. A real finding still blocks — that is
# the point — but only on a machine that could actually check.
#
# ⚠ THIS TAIL HAS ITS OWN SEAM, and it needs one for the same reason $CMD does. It is OUTSIDE the
# $CMD seam, so a probe that stubbed only $CMD still fell through into a live drift check — one that
# reaches the network and reads credentials. In CI that is decisive: actions/checkout leaves a
# DETACHED HEAD, `@{u}` fails, changedFiles() reports degraded, and `required` becomes true without
# consulting credentials the runner does not have. The hook then exits non-zero on a green chain,
# and the two success-direction probes in check-git-hooks.mjs failed for a property neither is
# about. The hook was right; the probe was measuring the tail by accident.
# Same two-variable contract as above — PLEKS_DRIFT_CMD alone is ignored — so this adds no bypass
# that PLEKS_PREPUSH_CMD did not already offer to anyone willing to set PLEKS_HOOK_PROBE=1.
if [ -n "$PLEKS_DRIFT_CMD" ] && [ "$PLEKS_HOOK_PROBE" = "1" ]; then
  DRIFT="$PLEKS_DRIFT_CMD"
else
  DRIFT="node scripts/check-drift-if-sql-changed.mjs"
fi
# NOT an arrow line. check-git-hooks.mjs reads the LAST "→" line as the command the hook resolved
# for its main chain; adding a second arrow here would silently redirect that assertion onto the
# tail. Its own marker keeps the two properties separately observable.
echo "[drift-seam] $DRIFT"
$DRIFT
