#!/bin/sh
# .githooks/pre-push — M-007. Blocks a push that fails the check chain.
#
# Git feeds this hook `<local ref> <local sha> <remote ref> <remote sha>` on stdin. It is consumed
# here and PIPED TO THE SCOPE, because the scope must follow what is being PUSHED, not what happens
# to be checked out: `git push origin migration-branch` from a docs branch previously returned
# "quick" and skipped the DB tier on a diff full of migrations.
#
# The DB tier (test:db + security:db, ~8 of the ~10 minutes) runs only when the diff can affect it.
# CI's db-tests job runs it on every PR regardless, so it is moved off the local hot path, never
# skipped. Fails toward MORE checking: any error deciding runs the full chain.
set -e
REFS=$(cat)

# PLEKS_PREPUSH_CMD is a probe seam and requires PLEKS_HOOK_PROBE=1 alongside it. Without that
# second variable it is ignored — `PLEKS_PREPUSH_CMD=true git push` used to be a silent, complete
# bypass, functionally --no-verify, which CLAUDE.md forbids by name. Two variables is not security;
# it is the difference between a deliberate act and a convenient one.
if [ -n "$PLEKS_PREPUSH_CMD" ] && [ "$PLEKS_HOOK_PROBE" = "1" ]; then
  CMD="$PLEKS_PREPUSH_CMD"
else
  SCOPE=$(printf '%s\n' "$REFS" | node scripts/prepush-scope.mjs 2>/dev/null || echo full)
  if [ "$SCOPE" = "quick" ]; then
    CMD="npm run check"
    echo "pre-push → pushed refs touch no DB surface; running check (DB tier runs in CI on the PR)"
  else
    CMD="npm run check:full"
    echo "pre-push → pushed refs touch DB surface; running the full chain"
  fi
fi
echo "pre-push → $CMD"
$CMD
