# docuseal data — the self-hosted container's local volumes, at the REPO ROOT.
# ⚠ ANCHORED WITH A LEADING SLASH ON PURPOSE. Unanchored, `docuseal/` matches a directory of that
# name at ANY depth, and it did: it silently covered `app/api/webhooks/docuseal/`, the live DocuSeal
# webhook route. `route.ts` survived only because tracked files stay tracked once added — a NEW file
# in that directory did not appear in `git status` at all, which is the failure mode that gets
# noticed after the deploy rather than before it. Verified by planting a file there and watching git
# fail to see it. Anchor any future data-directory pattern the same way.
/docuseal_data/
/docuseal/

# ssh keys / secrets — never commit, from any path in the tree
id_ed25519*
id_rsa*
*.pem
*.ppk

# typescript
*.tsbuildinfo
next-env.d.ts

# generated reports
schema-drift-report.md
sonar-report.txt
sonar-results.json
# npm run test:report output (self-contained HTML dashboards; keeps newest 3)
test/reports/

# generated PDF samples (render script outputs)
lib/reports/screening/_pdf/__samples__/

# Claude Code state. `.claude/*` rather than `.claude/`: a trailing-slash ignore stops git
# descending at all, so no negation inside it can re-include anything. Everything here was
# tracked only because someone remembered `git add -f`, and on 2026-08-19 two new files —
# .claude/crawlers/INTENTIONAL.md (a BUILD BLOCKER: scripts/crawl.mjs refuses to run without it)
# and .claude/agents/crawler-doctrine.md — were silently not committed by `git add -A`, while the
# commit message said they were. The tracked subtrees are now explicit.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/crawlers/
!.claude/hooks/
!.claude/rules/
!.claude/skills/
!.claude/settings.json
!.claude/statusline.js
# Machine-local, never shared: personal permission overrides and session scratch.
.claude/settings.local.json
# Per-machine token accounting written by the context-budget hook. Byte offsets and running totals
# for THIS clone's transcript — meaningless in another checkout, and it changes on every prompt.
.claude/.context-budget.state.json

# Build specs, legal docs, and design references — local only
brief/

# Acceptance-run museum: REAL MRI exports carry real SA ID numbers + names (POPIA).
# The README documenting the museum stays tracked; the exports never leave this machine.
test/db/fixtures/museum/*.xlsx
test/db/fixtures/museum/*.csv

# Codemod dry-run/report output (regenerated each run)
scripts/codemod-supabase-error.report.json

# Supabase local dev runtime state (config.toml + migrations stay tracked)
supabase/.branches/
supabase/.temp/linked-project.json
supabase/.temp/pgdelta/

# ESLint cache — local only, rebuilt by scripts/eslint-cache-guard.mjs (never committed)
.eslintcache
.eslintcache.key

# agent handoff artefacts — task-scoped, cleared by /wrap (4-AGENT-PIPELINES.md §9)
.handoff/
